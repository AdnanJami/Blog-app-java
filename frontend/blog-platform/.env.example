# Base URL of the Spring Boot API (read at build time for browser code)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Optional: address of the API as seen from the Next.js server, if different (read at runtime)
# API_URL=http://backend:8081/api/v1

# Optional: send the login cookie over plain HTTP in a production build (default: HTTPS-only)
# COOKIE_SECURE=false
